rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only users with a server/console-provisioned members/{uid} record can read cases.
    // Client-side writes to member role records are deliberately forbidden.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /case_files/{caseId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == "admin";
    }

    match /audit_logs/{logId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
